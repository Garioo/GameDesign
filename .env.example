# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).
# Supabase values: Dashboard → Project Settings → API.
# All NEXT_PUBLIC_* values are bundled into the client by design — only the
# anon (publishable) key belongs here. NEVER put the service_role key in any
# NEXT_PUBLIC_ variable or anywhere in this repo.
NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=your-tldraw-license-key
